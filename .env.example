# DB_* = the database for THIS deploy of the admin platform.
# Local machine → local MySQL. Production deploy → production MySQL.
# Switch credentials per environment (Railway env vars vs local .env).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=granteddb

# Optional: staging MySQL. When set, the admin UI can switch all reads/writes
# (pilots, surveys, monitoring, analytics) to staging without redeploying.
# Use the Railway public proxy host/port (proxy port is NOT 3306).
STAGING_HOST=
STAGING_PORT=
STAGING_USER=
STAGING_PASSWORD=
STAGING_DATABASE=
# Staging Stripe (used when Database switch is Staging). Do not reuse STRIPE_SECRET_KEY.
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_PUBLISHABLE_KEY=
STAGING_STRIPE_WEBHOOK=
STAGING_STRIPE_PRICE_ID=

ADMIN_PASSWORD=change-me
SECRET_KEY=change-me
TEST_BASE_URL=https://your-granted-app.example.com
ADMIN_TIMEZONE=America/New_York
# This-environment Stripe (local or prod deploy).
STRIPE_SECRET_KEY=
